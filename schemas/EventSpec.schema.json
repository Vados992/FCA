{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "earliest": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
      "type": "string"
    },
    "known_at": {
      "type": "string"
    },
    "latest": {
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "entity",
    "earliest",
    "latest",
    "known_at",
    "evidence_refs"
  ],
  "title": "EventSpec",
  "type": "object"
}
