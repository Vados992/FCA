{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contradiction_link_ref": {
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "review_ref": {
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "contradiction_link_ref",
    "evidence_refs",
    "rationale",
    "review_ref"
  ],
  "title": "ResolutionSpec",
  "type": "object"
}
