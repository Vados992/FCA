{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closure_type": {
      "enum": [
        "time_unrolled_feedback"
      ],
      "type": "string"
    },
    "edge_verdict_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "event_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "closure_type",
    "event_refs",
    "edge_verdict_refs"
  ],
  "title": "ClosureSpec",
  "type": "object"
}
