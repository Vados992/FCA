{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causal_only": {
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SUPPORTED",
        "FAILED",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "key",
    "statement",
    "status",
    "evidence_refs",
    "rationale"
  ],
  "title": "AssumptionSpec",
  "type": "object"
}
