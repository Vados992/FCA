{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_ref": {
      "type": "string"
    },
    "evidence_ref": {
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
      "type": "string"
    },
    "material": {
      "type": "boolean"
    },
    "role": {
      "enum": [
        "supports",
        "contradicts",
        "neutral"
      ],
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "evidence_ref",
    "claim_ref",
    "role"
  ],
  "title": "EvidenceLink",
  "type": "object"
}
